<ui:FluentWindow x:Class="SlackWake.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:SlackWake.Helpers"
        Title="SlackWake"
        Icon="/Assets/app.ico"
        Width="500" Height="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="420" MinHeight="520"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>

        <!-- Collapses an element when its bound bool is false (used for the
             minutes/seconds breakdown that only shows past a one-minute cap). -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Caption beneath each section/row title. Kept as a single style so the
             secondary-text treatment stays consistent across the whole window. -->
        <Style TargetType="ui:TextBlock" x:Key="Caption">
            <Setter Property="FontTypography" Value="Caption"/>
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Field label sitting above a slider / combo. -->
        <Style TargetType="ui:TextBlock" x:Key="FieldLabel">
            <Setter Property="FontTypography" Value="BodyStrong"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Numeric editor paired with a slider — compact, right-aligned, Fluent chrome.
             BasedOn the implicit WPF-UI TextBox style so it keeps the Fluent dark chrome;
             an explicit keyed style otherwise opts out of the implicit style entirely. -->
        <Style TargetType="TextBox" x:Key="NumericBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Flat color swatch. The default button chrome muddies the actual color the
             user picked, so the template strips it to a rounded Fluent surface that
             faithfully shows the selected color and lights up on hover. -->
        <Style TargetType="Button" x:Key="ColorSwatch">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Swatch"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <!-- A thin focus ring drawn on top so keyboard users can see
                                 which swatch is focused without disturbing the color. -->
                            <Border x:Name="Focus"
                                    CornerRadius="8"
                                    Margin="-2"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Fluent title bar; the window draws content right up to the edge
             (Mica backdrop). Closing hides to tray (handled in MainWindow.OnClosing). -->
        <ui:TitleBar Grid.Row="0"
                     Title="SlackWake"
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- DockPanel pins the status pill + test button at the bottom so they remain
             visible regardless of scroll position; the ScrollViewer fills the rest. -->
        <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,0">

            <!-- Status (pinned at the very bottom) -->
            <ui:Card DockPanel.Dock="Bottom" Margin="24,0,24,20" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="12" Height="12" Margin="0,0,10,0"
                            CornerRadius="6"
                            Background="{Binding StatusBrush}"
                            VerticalAlignment="Center"/>
                    <ui:TextBlock Text="{Binding Status}"
                                  FontTypography="BodyStrong"
                                  TextWrapping="Wrap"
                                  VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Card>

            <!-- Primary action (pinned just above status) -->
            <ui:Button DockPanel.Dock="Bottom"
                       Margin="24,0,24,12"
                       Height="40"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Eye24}"
                       Command="{Binding TestOverlayCommand}"
                       Content="Test overlay with current settings"
                       ToolTip="Show a sample overlay right now using your current sound and flash settings (bypasses idle check)."/>

            <!-- Scrollable settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,8,24,8">
                <StackPanel>

                    <!-- Hero header -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <!-- Brand mark drawn as vector geometry (squircle tile + bell),
                             not a rasterized .ico. Resolution-independent, so it stays
                             pixel-sharp at any window size or display scale — the same
                             bell silhouette as TrayIconFactory / generate-app-icon.ps1. -->
                        <Grid Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border CornerRadius="9.5" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3ACC90" Offset="0"/>
                                        <GradientStop Color="#1E9E6A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- The bell lives on the canonical 32x32 canvas (same as
                                 TrayIconFactory / generate-app-icon.ps1). The explicit square
                                 canvas is what centers it: scaling the Path's own bounds left a
                                 gap on the left because the geometry starts at x=5, not x=0,
                                 which shoved the bell to the right. -->
                            <Viewbox Width="24" Height="24" Stretch="Uniform">
                                <Canvas Width="32" Height="32">
                                    <Path Fill="White"
                                          Data="M14,4 L18,4 L18,7 C23,7.5 24,12 24,16 L24,22 L27,24 L27,25.5 L5,25.5 L5,24 L8,22 L8,16 C8,12 9,7.5 14,7 L14,4 Z M14.5,28 A1.5,1.5 0 1 0 17.5,28 A1.5,1.5 0 1 0 14.5,28 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="SlackWake" FontTypography="Title"/>
                            <ui:TextBlock Text="Wake me up when Slack pings during idle time."
                                          Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- General -->
                    <ui:TextBlock Text="General" FontTypography="BodyStrong"
                                  Margin="2,18,0,8" Appearance="Secondary"/>
                    <ui:Card Padding="0">
                        <StackPanel>
                            <!-- Enable monitoring (master switch) -->
                            <Grid Margin="16,14,16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Alert24" FontSize="20"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Enable monitoring" FontTypography="Body"/>
                                    <ui:TextBlock Text="Watch for Slack pings while you're away."
                                                  Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding Enabled}"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Start with Windows -->
                            <Grid Margin="16,14,16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Power24" FontSize="20"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Start with Windows" FontTypography="Body"/>
                                    <ui:TextBlock Text="Launch SlackWake automatically at sign-in."
                                                  Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding StartWithWindows}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Idle & timing -->
                    <ui:TextBlock Text="Idle &amp; timing" FontTypography="BodyStrong"
                                  Margin="2,20,0,8" Appearance="Secondary"/>
                    <ui:Card Padding="16">
                        <StackPanel>
                            <!-- Idle timeout -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="18"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Idle timeout (seconds)" FontTypography="BodyStrong"
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBox DockPanel.Dock="Right"
                                             Style="{StaticResource NumericBox}"
                                             helpers:NumericTextBoxBehavior.Enabled="True"
                                             Text="{Binding IdleTimeoutSeconds, UpdateSourceTrigger=LostFocus}"/>
                                    <Slider Minimum="10" Maximum="1800"
                                            SmallChange="10" LargeChange="60"
                                            Value="{Binding IdleTimeoutSeconds}"
                                            VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>

                            <Border Height="1" Margin="0,16"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Alert delay (governs both sound and flash — they start together) -->
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Timer24" FontSize="18"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Alert delay (seconds)" FontTypography="BodyStrong"
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                                <ui:TextBlock Text="Wait this long after the overlay appears before sound and flash start."
                                              Style="{StaticResource Caption}" Margin="26,0,0,8"/>
                                <DockPanel LastChildFill="True">
                                    <TextBox DockPanel.Dock="Right"
                                             Style="{StaticResource NumericBox}"
                                             helpers:NumericTextBoxBehavior.Enabled="True"
                                             Text="{Binding SoundDelaySeconds, UpdateSourceTrigger=LostFocus}"/>
                                    <Slider Minimum="0" Maximum="120"
                                            SmallChange="1" LargeChange="5"
                                            Value="{Binding SoundDelaySeconds}"
                                            VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Alerts: sound and visual flash live in one group (a single Card),
                         kept visually distinct by full-width dividers. The auto-stop block
                         at the bottom is shared — its cap governs both the looping sound and
                         the flash, so it sits below both rather than inside either. -->
                    <ui:TextBlock Text="Alerts" FontTypography="BodyStrong"
                                  Margin="2,20,0,8" Appearance="Secondary"/>
                    <ui:Card Padding="16">
                        <StackPanel>

                            <!-- Sound alert -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Speaker224" FontSize="20"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Sound alert" FontTypography="Body"/>
                                    <ui:TextBlock Text="Play a sound when the overlay appears."
                                                  Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding SoundEnabled}"/>
                            </Grid>

                            <StackPanel IsEnabled="{Binding SoundEnabled}" Margin="0,16,0,0">
                                <ui:TextBlock Text="Sound" Style="{StaticResource FieldLabel}"/>
                                <DockPanel LastChildFill="True">
                                    <ui:Button DockPanel.Dock="Right"
                                               Width="40" Height="36"
                                               Margin="10,0,0,0"
                                               Padding="0"
                                               VerticalAlignment="Center"
                                               HorizontalContentAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Command="{Binding TogglePreviewCommand}"
                                               ToolTip="Preview selected sound">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="{Binding PreviewButtonIcon}"
                                                           Filled="True"
                                                           FontSize="18"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ComboBox ItemsSource="{Binding AvailableSounds}"
                                              SelectedItem="{Binding SelectedSound}"
                                              DisplayMemberPath="DisplayName"
                                              VerticalAlignment="Center"
                                              helpers:SoundHoverPreviewBehavior.PreviewCommand="{Binding PreviewSoundCommand}"
                                              helpers:SoundHoverPreviewBehavior.StopCommand="{Binding StopPreviewCommand}"
                                              helpers:SoundHoverPreviewBehavior.DelayMilliseconds="200"/>
                                </DockPanel>

                                <!-- Loop sound -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <ui:TextBlock Text="Loop sound" FontTypography="Body"/>
                                        <ui:TextBlock Text="Replay the alert continuously instead of playing once."
                                                      Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                     IsChecked="{Binding SoundLoop}"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Margin="0,16"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Visual flash -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Flash24" FontSize="20"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Visual flash" FontTypography="Body"/>
                                    <ui:TextBlock Text="Strobe the overlay between two colors."
                                                  Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding FlashEnabled}"/>
                            </Grid>

                            <StackPanel IsEnabled="{Binding FlashEnabled}" Margin="0,16,0,0">
                                <ui:TextBlock Text="Flash speed (milliseconds per color change)"
                                              Style="{StaticResource FieldLabel}"/>
                                <DockPanel LastChildFill="True">
                                    <TextBox DockPanel.Dock="Right"
                                             Style="{StaticResource NumericBox}"
                                             helpers:NumericTextBoxBehavior.Enabled="True"
                                             Text="{Binding FlashIntervalMs, UpdateSourceTrigger=LostFocus}"/>
                                    <Slider Minimum="100" Maximum="2000"
                                            SmallChange="50" LargeChange="200"
                                            Value="{Binding FlashIntervalMs}"
                                            VerticalAlignment="Center"/>
                                </DockPanel>

                                <ui:TextBlock Text="Flash colors"
                                              Style="{StaticResource FieldLabel}" Margin="0,16,0,2"/>
                                <ui:TextBlock Text="Click a swatch to change it; the overlay text picks its own contrast."
                                              Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ColorSwatch}"
                                            Background="{Binding FlashColorABrush}"
                                            Foreground="{Binding FlashColorAContrastBrush}"
                                            Command="{Binding PickFlashColorACommand}"
                                            Content="{Binding FlashColorA}"
                                            ToolTip="Click to choose the first flash color"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ColorSwatch}"
                                            Background="{Binding FlashColorBBrush}"
                                            Foreground="{Binding FlashColorBContrastBrush}"
                                            Command="{Binding PickFlashColorBCommand}"
                                            Content="{Binding FlashColorB}"
                                            ToolTip="Click to choose the second flash color"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Margin="0,16"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                            <!-- Auto-stop. Greys out unless at least one alert channel is
                                 active (sound enabled or visual flash on); a dismissed overlay
                                 with neither has nothing to cap. The sound and the visual flash
                                 opt in independently via the two toggles below. -->
                            <StackPanel IsEnabled="{Binding CanAutoStopAlerts}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="TimerOff24" FontSize="20"
                                                   Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Text="Stop alerts automatically" FontTypography="Body"/>
                                        <ui:TextBlock Text="Stop continuous alerts after a set time, even if the overlay is still open."
                                                      Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                     IsChecked="{Binding AlertAutoStopEnabled}"/>
                                </Grid>

                                <StackPanel IsEnabled="{Binding AlertAutoStopEnabled}" Margin="0,16,0,0">
                                    <!-- Which alerts to stop, then how long to wait — reads as one
                                         sentence with the master row: "Stop [these alerts]
                                         automatically [after this long]." Check boxes (not toggle
                                         switches) because this is a multi-select subset of one
                                         setting, not two standalone features. Each greys out when its
                                         channel is off entirely — nothing to time-box there. The sound
                                         box stays available even for a single (non-looping) play, since
                                         the cap can cut off a clip that runs longer than the limit. -->
                                    <ui:TextBlock Text="Alerts to stop" Style="{StaticResource FieldLabel}"
                                                  Margin="0,0,0,2"/>
                                    <ui:TextBlock Text="Unchecked alerts keep running until you dismiss the overlay."
                                                  Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="Stop Sound alert"
                                                  IsEnabled="{Binding CanAutoStopSound}"
                                                  IsChecked="{Binding AlertAutoStopIncludesSound}"
                                                  Margin="0,0,28,0"/>
                                        <CheckBox Content="Stop Visual flash"
                                                  IsEnabled="{Binding CanAutoStopVisual}"
                                                  IsChecked="{Binding AlertAutoStopIncludesVisual}"/>
                                    </StackPanel>

                                    <ui:TextBlock Text="Maximum duration (seconds)"
                                                  Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <DockPanel LastChildFill="True">
                                        <TextBox DockPanel.Dock="Right"
                                                 Style="{StaticResource NumericBox}"
                                                 helpers:NumericTextBoxBehavior.Enabled="True"
                                                 Text="{Binding AlertMaxDurationSeconds, UpdateSourceTrigger=LostFocus}"/>
                                        <Slider Minimum="5" Maximum="3600"
                                                SmallChange="5" LargeChange="60"
                                                Value="{Binding AlertMaxDurationSeconds}"
                                                VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ui:TextBlock Text="{Binding AlertMaxDurationFriendly}"
                                                  Style="{StaticResource Caption}"
                                                  Margin="0,6,0,0"
                                                  Visibility="{Binding ShowAlertMaxDurationFriendly, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Filters -->
                    <ui:TextBlock Text="Filters" FontTypography="BodyStrong"
                                  Margin="2,20,0,8" Appearance="Secondary"/>
                    <!-- Two independent, complementary filters, each its own card with its
                         own keyword list. "Mute by keyword" is a block-list; "Alert only by
                         keyword" is an allow-list. Distinct icons (bell-off vs bell-on) and
                         lead lines that each spell out what happens to the OTHER pings keep
                         them from blurring together. When both are on, the InfoBar below
                         explains how they combine. -->

                    <!-- Mute by keyword (block-list) -->
                    <ui:Card Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="FilterDismiss24" FontSize="20"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Mute by keyword" FontTypography="Body"/>
                                    <ui:TextBlock Text="Skip the overlay, sound, and flash for matching pings — everything else still wakes you."
                                                  Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding KeywordFilterEnabled}"/>
                            </Grid>

                            <StackPanel IsEnabled="{Binding KeywordFilterEnabled}" Margin="0,16,0,0">
                                <ui:TextBlock Text="Muted keywords" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBlock Text="A ping is muted when its sender, channel, or text contains any of these (case-insensitive). Wrap a phrase in double quotes to match it exactly, including commas."
                                              Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <!-- Grows with content: wraps long keyword lists, expands from
                                     3 up to 8 lines, then scrolls. AcceptsReturn lets the user
                                     lay entries out one-per-line for readability — newlines
                                     between entries are trimmed away during parsing. -->
                                <!-- helpers:Placeholder.Text overlays a top-aligned hint instead of
                                     WPF-UI's built-in PlaceholderText, which hardcodes
                                     VerticalAlignment="Center" and would float the hint in the
                                     vertical middle of this multi-line box. -->
                                <ui:TextBox helpers:Placeholder.Text="standup, #random, &quot;This is a test notification&quot;"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            MinLines="3"
                                            MaxLines="8"
                                            VerticalContentAlignment="Top"
                                            VerticalScrollBarVisibility="Auto"
                                            Text="{Binding KeywordFilterText, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Alert only by keyword (allow-list) -->
                    <ui:Card Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="AlertOn24" FontSize="20"
                                               Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Alert only by keyword" FontTypography="Body"/>
                                    <ui:TextBlock Text="Wake you only for matching pings — everything else stays silent."
                                                  Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding KeywordAllowEnabled}"/>
                            </Grid>

                            <StackPanel IsEnabled="{Binding KeywordAllowEnabled}" Margin="0,16,0,0">
                                <ui:TextBlock Text="Allowed keywords" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBlock Text="Only pings whose sender, channel, or text contains one of these will wake you (case-insensitive). Wrap a phrase in double quotes to match it exactly, including commas. Leave empty to disable."
                                              Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ui:TextBox helpers:Placeholder.Text="@here, #incidents, &quot;on call&quot;"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            MinLines="3"
                                            MaxLines="8"
                                            VerticalContentAlignment="Top"
                                            VerticalScrollBarVisibility="Auto"
                                            Text="{Binding KeywordAllowText, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Shown only when both filters are on — the one moment their
                         interaction isn't self-evident. Spells out the precedence so the
                         user isn't left guessing which wins. -->
                    <ui:InfoBar Margin="0,12,0,0"
                                IsOpen="{Binding ShowFilterInteractionNote}"
                                IsClosable="False"
                                Severity="Informational"
                                Title="Both filters are on"
                                Message="A ping wakes you only if it matches an allowed keyword and does not match a muted keyword. If a keyword is in both lists, muting wins."
                                Visibility="{Binding ShowFilterInteractionNote, Converter={StaticResource BoolToVis}}"/>

                    <!-- Setup note -->
                    <ui:InfoBar Margin="0,20,0,8"
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Title="Setup"
                                Message="SlackWake reads Slack's native Windows toasts. Make sure the Slack desktop app is running, and that Windows notifications are allowed for SlackWake (Settings &gt; Privacy &amp; security &gt; Notifications)."/>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
