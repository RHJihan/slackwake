<Window x:Class="SlackWake.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlackWake"
        Width="440" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FAFAFA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="SlackWake"
                   FontSize="22" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="Wake me up when Slack pings during idle time."
                   Foreground="#777" Margin="0,0,0,16"/>

        <!-- Toggles -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox Content="Enable monitoring"
                      IsChecked="{Binding Enabled}"
                      Margin="0,4"/>
            <CheckBox Content="Start with Windows"
                      IsChecked="{Binding StartWithWindows}"
                      Margin="0,4"/>
        </StackPanel>

        <!-- Idle timeout -->
        <StackPanel Grid.Row="3" Margin="0,4,0,8">
            <TextBlock Style="{StaticResource Label}" Text="Idle timeout (seconds)"/>
            <DockPanel LastChildFill="True">
                <TextBox DockPanel.Dock="Right"
                         Width="64"
                         Margin="8,0,0,0"
                         TextAlignment="Right"
                         Text="{Binding IdleTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                <Slider Minimum="10" Maximum="1800"
                        SmallChange="10" LargeChange="60"
                        Value="{Binding IdleTimeoutSeconds}"
                        VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <!-- Setup note -->
        <Border Grid.Row="4" Margin="0,8,0,8"
                Background="#FFF8E1" BorderBrush="#F1D479" BorderThickness="1"
                CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#665" Text="Setup"/>
                <TextBlock Foreground="#665" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="SlackWake reads Slack's native Windows toasts. Make sure the Slack desktop app is running, and that Windows notifications are allowed for SlackWake (Settings &gt; Privacy &amp; security &gt; Notifications)."/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="6"
                Background="#F0F0F0"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                         Fill="LimeGreen"
                         VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Status}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
