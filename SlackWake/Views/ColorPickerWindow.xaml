<ui:FluentWindow x:Class="SlackWake.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:SlackWake.Helpers"
        Title="Choose a color"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- Small, square swatch used in the preset palette. Flat Fluent surface so
             the color reads true; a soft hover/focus ring keeps it keyboard-friendly. -->
        <Style TargetType="Button" x:Key="PresetSwatch">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Swatch"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True"/>
                            <Border x:Name="Ring"
                                    CornerRadius="7" Margin="-2"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact channel label (R / G / B / Hex) sitting above its editor. -->
        <Style TargetType="ui:TextBlock" x:Key="ChannelLabel">
            <Setter Property="FontTypography" Value="Caption"/>
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ChannelBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Choose a color" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="20,8,20,20">

            <!-- Spectrum: saturation/value plane + hue rail + live preview. -->
            <Grid Height="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Saturation (x) / Value (y) plane. The base hue layer is painted in
                     code; the two gradients overlay white→transparent (left→right) and
                     transparent→black (top→bottom) to sweep saturation and value. -->
                <Border x:Name="SvBox" Grid.Column="0"
                        CornerRadius="8" ClipToBounds="True"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Cursor="Cross"
                        MouseLeftButtonDown="SvBox_MouseLeftButtonDown"
                        MouseMove="SvBox_MouseMove"
                        MouseLeftButtonUp="SvBox_MouseLeftButtonUp">
                    <Grid>
                        <Border x:Name="SvHueLayer"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <!-- Ring thumb: white outer + black inner so it stays visible
                                 against any underlying color. -->
                            <Grid x:Name="SvThumb" Width="18" Height="18">
                                <Ellipse Stroke="White" StrokeThickness="2.5"/>
                                <Ellipse Stroke="#80000000" StrokeThickness="1" Margin="1.5"/>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Hue rail (0° top → 360° bottom). -->
                <Border x:Name="HueBar" Grid.Column="2"
                        CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Cursor="SizeNS"
                        MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
                        MouseMove="HueBar_MouseMove"
                        MouseLeftButtonUp="HueBar_MouseLeftButtonUp">
                    <Grid>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFF0000" Offset="0.000"/>
                                    <GradientStop Color="#FFFFFF00" Offset="0.167"/>
                                    <GradientStop Color="#FF00FF00" Offset="0.333"/>
                                    <GradientStop Color="#FF00FFFF" Offset="0.500"/>
                                    <GradientStop Color="#FF0000FF" Offset="0.667"/>
                                    <GradientStop Color="#FFFF00FF" Offset="0.833"/>
                                    <GradientStop Color="#FFFF0000" Offset="1.000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="HueThumb"
                                    Width="28" Height="6"
                                    CornerRadius="3"
                                    Background="White"
                                    BorderBrush="#80000000"
                                    BorderThickness="1"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Live preview of the picked color, with a high-contrast hex caption. -->
                <Border x:Name="PreviewSwatch" Grid.Column="4"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <ui:TextBlock x:Name="PreviewHex"
                                  FontFamily="Consolas" FontSize="13"
                                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                  Margin="0,0,0,10"/>
                </Border>
            </Grid>

            <!-- Hex + RGB editors. -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ui:TextBlock Text="Hex" Style="{StaticResource ChannelLabel}"/>
                    <TextBox x:Name="HexBox" Style="{StaticResource ChannelBox}"
                             MaxLength="7" CharacterCasing="Upper"
                             TextChanged="HexBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <ui:TextBlock Text="R" Style="{StaticResource ChannelLabel}"/>
                    <TextBox x:Name="RBox" Style="{StaticResource ChannelBox}"
                             MaxLength="3" helpers:NumericTextBoxBehavior.Enabled="True"
                             TextChanged="RgbBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <ui:TextBlock Text="G" Style="{StaticResource ChannelLabel}"/>
                    <TextBox x:Name="GBox" Style="{StaticResource ChannelBox}"
                             MaxLength="3" helpers:NumericTextBoxBehavior.Enabled="True"
                             TextChanged="RgbBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <ui:TextBlock Text="B" Style="{StaticResource ChannelLabel}"/>
                    <TextBox x:Name="BBox" Style="{StaticResource ChannelBox}"
                             MaxLength="3" helpers:NumericTextBoxBehavior.Enabled="True"
                             TextChanged="RgbBox_TextChanged"/>
                </StackPanel>
            </Grid>

            <!-- Preset palette — quick picks tuned for high-visibility flash colors. -->
            <ui:TextBlock Text="Palette" Style="{StaticResource ChannelLabel}" Margin="2,18,0,8"/>
            <WrapPanel x:Name="PresetPanel"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="Cancel" MinWidth="96"
                           Click="Cancel_Click" IsCancel="True"/>
                <ui:Button Content="Select" MinWidth="96" Margin="10,0,0,0"
                           Appearance="Primary" Click="Select_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
