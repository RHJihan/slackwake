<Window x:Class="SlackWake.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="#E6000000"
        Cursor="Arrow"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        TextInput="Window_TextInput">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1100">

            <TextBlock Text="Slack notification received"
                       FontSize="64"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <TextBlock x:Name="ChannelText"
                       FontSize="40" FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,28,0,0"/>

            <TextBlock x:Name="SenderText"
                       FontSize="40" FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

            <Border Background="#22FFFFFF"
                    CornerRadius="10"
                    Padding="24,16"
                    Margin="0,28,0,0">
                <TextBlock x:Name="MessageText"
                           FontSize="20"
                           Foreground="White"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </Border>

            <TextBlock Text="Press ESC, click, or type any key to dismiss"
                       FontSize="14" Foreground="#999"
                       HorizontalAlignment="Center"
                       Margin="0,40,0,0"/>
        </StackPanel>
    </Grid>
</Window>
