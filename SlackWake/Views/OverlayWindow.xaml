<Window x:Class="SlackWake.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="{DynamicResource OverlayBackgroundBrush}"
        Cursor="Arrow"
        FontFamily="Segoe UI Variable Text"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        TextInput="Window_TextInput">
    <Window.Resources>
        <!-- Named brushes so the flash storyboard can swap colors at runtime
             without rebuilding the visual tree. Foreground flips opposite to
             background so the text stays readable in either flash state. Every
             visual below binds to these via {DynamicResource} so the whole alert
             flips in lockstep — added Fluent chrome must use these keys too, never
             a fixed color, or it would vanish against one of the flash colors. -->
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#E6000000"/>
        <SolidColorBrush x:Key="OverlayForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="OverlayMessageBoxBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="OverlayHintBrush" Color="#FF999999"/>
    </Window.Resources>

    <Grid>
        <StackPanel x:Name="AlertContent"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="1180"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </StackPanel.RenderTransform>

            <!-- Subtle entrance: fade + scale-up. Purely visual; runs in parallel with
                 the focus wiring in OnLoaded and never blocks dismissal. -->
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.28"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0.96" To="1" Duration="0:0:0.34">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0.96" To="1" Duration="0:0:0.34">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <!-- Alert glyph -->
            <ui:SymbolIcon Symbol="Alert48"
                           FontSize="76"
                           Filled="True"
                           Foreground="{DynamicResource OverlayForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

            <TextBlock Text="Slack notification received"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="64"
                       FontWeight="Bold"
                       Foreground="{DynamicResource OverlayForegroundBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <TextBlock x:Name="ChannelText"
                       FontSize="38" FontWeight="SemiBold"
                       Foreground="{DynamicResource OverlayForegroundBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,28,0,0"/>

            <TextBlock x:Name="SenderText"
                       FontSize="38" FontWeight="SemiBold"
                       Foreground="{DynamicResource OverlayForegroundBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,8,0,0"/>

            <Border Background="{DynamicResource OverlayMessageBoxBrush}"
                    BorderBrush="{DynamicResource OverlayHintBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32,22"
                    Margin="0,32,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <TextBlock x:Name="MessageText"
                           FontSize="22"
                           Foreground="{DynamicResource OverlayForegroundBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </Border>

            <!-- Dismiss hint, presented as a Fluent pill. -->
            <Border Background="{DynamicResource OverlayMessageBoxBrush}"
                    CornerRadius="14"
                    Padding="18,8"
                    Margin="0,44,0,0"
                    HorizontalAlignment="Center">
                <TextBlock Text="Press ESC, click, or type any key to dismiss"
                           FontSize="14"
                           Foreground="{DynamicResource OverlayHintBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
