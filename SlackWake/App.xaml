<Application x:Class="SlackWake.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI Fluent 2 theme. ThemesDictionary supplies the color palette
                     (corrected to the live Windows light/dark theme at startup by
                     ApplicationThemeManager.ApplySystemTheme in App.xaml.cs); the
                     ControlsDictionary applies implicit Fluent styling to the base WPF
                     controls (Button, CheckBox, ComboBox, TextBox, Slider, ScrollViewer…)
                     so existing controls and their behaviors are restyled, not replaced. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
